{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "上海高考数学试卷元数据标准",
  "description": "用于描述上海高考数学一模/二模/高考试卷的元数据结构和标签体系",
  "version": "1.0.0",
  "type": "object",
  "required": ["id", "title", "year", "region", "exam_type", "questions"],
  "properties": {
    "id": {
      "type": "string",
      "description": "试卷唯一标识符，格式：{年份}届{区域}{考试类型}数学试卷",
      "pattern": "^\\d{4}届[\\u4e00-\\u9fa5]+(一模|二模|高考)数学试卷$",
      "example": "2026届浦东新区高三下二模数学试卷"
    },
    "title": {
      "type": "string",
      "description": "试卷完整标题",
      "example": "2026届浦东新区高三下二模数学试卷（解析版）"
    },
    "year": {
      "type": "integer",
      "description": "考试年份",
      "minimum": 2020,
      "maximum": 2030,
      "example": 2026
    },
    "region": {
      "type": "string",
      "description": "考试区域/区县",
      "enum": [
        "上海市", "浦东新区", "黄浦区", "静安区", "徐汇区", "长宁区",
        "普陀区", "虹口区", "杨浦区", "闵行区", "宝山区", "嘉定区",
        "金山区", "松江区", "青浦区", "奉贤区", "崇明区", "各区汇总"
      ],
      "example": "浦东新区"
    },
    "exam_type": {
      "type": "string",
      "description": "考试类型",
      "enum": ["一模", "二模", "高考", "期中", "期末", "月考", "专题练习"],
      "example": "二模"
    },
    "exam_time": {
      "type": "string",
      "format": "date",
      "description": "考试日期（可选）",
      "example": "2026-04-15"
    },
    "semester": {
      "type": "string",
      "description": "学期",
      "enum": ["上", "下", "全学年"],
      "example": "下"
    },
    "grade": {
      "type": "string",
      "description": "年级",
      "enum": ["高一", "高二", "高三"],
      "example": "高三"
    },
    "total_score": {
      "type": "integer",
      "description": "试卷满分",
      "default": 150,
      "example": 150
    },
    "duration": {
      "type": "integer",
      "description": "考试时长（分钟）",
      "default": 120,
      "example": 120
    },
    "difficulty_overall": {
      "type": "number",
      "description": "整体难度系数（0-1，1为最难）",
      "minimum": 0,
      "maximum": 1,
      "example": 0.65
    },
    "files": {
      "type": "object",
      "description": "试卷相关文件路径",
      "properties": {
        "student_version_pdf": {
          "type": "string",
          "description": "学生版PDF路径"
        },
        "teacher_version_pdf": {
          "type": "string",
          "description": "教师版PDF路径"
        },
        "student_version_tex": {
          "type": "string",
          "description": "学生版LaTeX源文件路径"
        },
        "teacher_version_tex": {
          "type": "string",
          "description": "教师版LaTeX源文件路径"
        },
        "parsed_md": {
          "type": "string",
          "description": "解析后的Markdown文件路径"
        },
        "images_folder": {
          "type": "string",
          "description": "图片资源文件夹路径"
        }
      }
    },
    "questions": {
      "type": "array",
      "description": "题目列表",
      "items": {
        "type": "object",
        "required": ["question_number", "question_type", "score"],
        "properties": {
          "question_number": {
            "type": ["integer", "string"],
            "description": "题号",
            "example": 1
          },
          "question_type": {
            "type": "string",
            "description": "题型",
            "enum": ["填空题", "选择题", "解答题", "压轴题"],
            "example": "填空题"
          },
          "sub_type": {
            "type": "string",
            "description": "细分题型",
            "enum": ["单选", "多选", "单空", "双空", "计算", "证明", "应用", "探究"],
            "example": "单空"
          },
          "score": {
            "type": "integer",
            "description": "分值",
            "example": 4
          },
          "difficulty": {
            "type": "integer",
            "description": "难度等级（1-5星）",
            "minimum": 1,
            "maximum": 5,
            "example": 2
          },
          "knowledge_points": {
            "type": "array",
            "description": "知识点标签列表",
            "items": {
              "type": "string"
            },
            "example": ["集合", "补集运算"]
          },
          "knowledge_category": {
            "type": "string",
            "description": "知识模块分类",
            "enum": [
              "预备知识", "函数", "三角与三角函数", "向量", "解析几何",
              "立体几何", "概率统计", "数列", "导数与微积分", "复数",
              "逻辑与集合", "不等式", "数学建模", "新定义问题"
            ],
            "example": "预备知识"
          },
          "content_summary": {
            "type": "string",
            "description": "题目内容摘要（可选）",
            "example": "已知全集和集合，求补集"
          },
          "answer": {
            "type": "string",
            "description": "答案（可选）"
          },
          "solution_steps": {
            "type": "array",
            "description": "解题步骤（可选）",
            "items": {
              "type": "string"
            }
          },
          "is_key_question": {
            "type": "boolean",
            "description": "是否为重点/难题",
            "default": false
          },
          "is_new_type": {
            "type": "boolean",
            "description": "是否为新题型/创新题",
            "default": false
          },
          "has_image": {
            "type": "boolean",
            "description": "是否包含图片",
            "default": false
          },
          "image_refs": {
            "type": "array",
            "description": "图片引用路径",
            "items": {
              "type": "string"
            }
          },
          "source_page": {
            "type": "integer",
            "description": "在PDF中的页码"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "试卷统计信息（可选）",
      "properties": {
        "total_questions": {
          "type": "integer",
          "description": "总题数"
        },
        "fill_blank_count": {
          "type": "integer",
          "description": "填空题数量"
        },
        "choice_count": {
          "type": "integer",
          "description": "选择题数量"
        },
        "solution_count": {
          "type": "integer",
          "description": "解答题数量"
        },
        "knowledge_distribution": {
          "type": "object",
          "description": "知识点分布统计",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "difficulty_distribution": {
          "type": "object",
          "description": "难度分布统计",
          "properties": {
            "1_star": {"type": "integer"},
            "2_star": {"type": "integer"},
            "3_star": {"type": "integer"},
            "4_star": {"type": "integer"},
            "5_star": {"type": "integer"}
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "自定义标签",
      "items": {
        "type": "string"
      },
      "example": ["经典", "易错", "创新", "压轴"]
    },
    "metadata": {
      "type": "object",
      "description": "元数据信息",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "更新时间"
        },
        "created_by": {
          "type": "string",
          "description": "创建者"
        },
        "version": {
          "type": "string",
          "description": "数据版本"
        }
      }
    }
  },
  "definitions": {
    "knowledgePointTags": {
      "type": "object",
      "description": "知识点标签体系定义",
      "properties": {
        "预备知识": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "集合", "集合运算", "补集", "交集", "并集",
            "命题", "充分必要条件", "逻辑联结词",
            "不等式", "基本不等式", "绝对值不等式"
          ]
        },
        "函数": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "函数概念", "函数定义域", "函数值域", "函数单调性",
            "函数奇偶性", "函数周期性", "函数对称性",
            "幂函数", "指数函数", "对数函数",
            "指数运算", "对数运算", "指对互化",
            "函数零点", "函数图像", "函数最值",
            "分段函数", "复合函数", "抽象函数",
            "反函数"
          ]
        },
        "三角与三角函数": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "弧度制", "角度制", "三角比",
            "正弦函数", "余弦函数", "正切函数",
            "三角函数图像", "三角函数性质", "三角函数周期",
            "和差公式", "倍角公式", "半角公式",
            "辅助角公式", "积化和差", "和差化积",
            "解三角形", "正弦定理", "余弦定理",
            "三角形面积", "三角恒等变换"
          ]
        },
        "向量": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "平面向量", "空间向量", "向量概念",
            "向量加法", "向量减法", "数乘向量",
            "向量数量积", "向量坐标运算",
            "向量平行", "向量垂直", "向量夹角",
            "向量模", "向量分解", "基底",
            "共面向量", "向量应用"
          ]
        },
        "解析几何": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "直线方程", "直线斜率", "直线位置关系",
            "圆的方程", "圆的性质", "直线与圆",
            "椭圆", "双曲线", "抛物线",
            "圆锥曲线", "曲线方程", "轨迹方程",
            "圆锥曲线性质", "焦点", "准线", "离心率",
            "圆锥曲线综合", "参数方程", "极坐标"
          ]
        },
        "立体几何": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "空间几何体", "棱柱", "棱锥", "棱台",
            "圆柱", "圆锥", "圆台", "球",
            "三视图", "直观图", "表面积", "体积",
            "空间直线", "空间平面", "线面关系",
            "线线平行", "线面平行", "面面平行",
            "线线垂直", "线面垂直", "面面垂直",
            "空间角", "异面直线所成角", "线面角", "二面角",
            "空间距离", "点到平面距离",
            "空间坐标系", "空间向量法"
          ]
        },
        "概率统计": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "随机事件", "概率", "古典概型", "几何概型",
            "互斥事件", "对立事件", "独立事件",
            "条件概率", "全概率公式", "贝叶斯公式",
            "随机变量", "离散型随机变量", "连续型随机变量",
            "分布列", "期望", "方差", "标准差",
            "二项分布", "正态分布", "超几何分布",
            "统计", "抽样", "样本", "总体",
            "频率分布", "直方图", "茎叶图",
            "平均数", "中位数", "众数", "方差",
            "回归分析", "相关系数", "独立性检验"
          ]
        },
        "数列": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "数列概念", "通项公式", "递推公式",
            "等差数列", "等差数列通项", "等差数列求和",
            "等比数列", "等比数列通项", "等比数列求和",
            "数列求和", "裂项相消", "错位相减", "分组求和",
            "数列极限", "数学归纳法",
            "数列综合", "数列与函数", "数列与不等式"
          ]
        },
        "导数与微积分": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "导数概念", "导数几何意义", "切线",
            "求导公式", "导数四则运算", "复合函数求导",
            "函数单调性与导数", "函数极值", "函数最值",
            "导数应用", "构造函数", "不等式证明",
            "定积分", "微积分基本定理"
          ]
        },
        "复数": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "复数概念", "复数相等", "复数模",
            "复数四则运算", "共轭复数",
            "复数几何意义", "复平面", "复数三角形式"
          ]
        },
        "新定义问题": {
          "type": "array",
          "items": {"type": "string"},
          "enum": [
            "新定义运算", "新定义概念", "新定义性质",
            "阅读理解", "创新探究", "开放性问题"
          ]
        }
      }
    }
  }
}
