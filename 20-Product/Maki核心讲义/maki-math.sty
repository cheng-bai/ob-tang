        \centering
        \vspace*{5cm}
        
        {\fontsize{48pt}{60pt}\selectfont\heavykaishu \color{LogicColor} \LectureNotesTitle\par}
        
        \vfill
        
        {\LARGE \kaishu \AuthorInfo}
        
        \vspace{2.3cm}
        
        {\Large \kaishu
        学\ 海\ 悠\ 悠\quad 研\ 途\ 漫\ 漫
        \\[0.3em]
        {\Large 以此薄卷赠诸生共勉}
        \\[2.5em]
        二\ 〇\ 二\ 六\ 年\ 三\ 月 
        }
        
        \vspace{2cm}
    \end{titlepage}%
}

